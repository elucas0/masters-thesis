\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Per-band raw digital number distributions by sensor (log scale; boxes = IQR, whiskers = $1.5\times $IQR, outliers hidden; 400{,}000 sampled pixels). Real $\Phi $-sat-2 occupies a scale roughly one order of magnitude below Sentinel-2 and its simulated counterpart, which closely overlap each other. }}{14}{figure.caption.10}\protected@file@percent }
\newlabel{fig:band-boxplots}{{3.6}{14}{Per-band raw digital number distributions by sensor (log scale; boxes = IQR, whiskers = $1.5\times $IQR, outliers hidden; 400{,}000 sampled pixels). Real $\Phi $-sat-2 occupies a scale roughly one order of magnitude below Sentinel-2 and its simulated counterpart, which closely overlap each other}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces The same per-band distributions after per-sensor $z$-score normalization of $\sqrt  {\text  {DN}}$. Location and scale are aligned, but real $\Phi $-sat-2 retains a wider spread than Sentinel-2 or the simulated domain in every band -- the residual gap normalization alone cannot close. }}{14}{figure.caption.11}\protected@file@percent }
\newlabel{fig:band-boxplots-normalized}{{3.7}{14}{The same per-band distributions after per-sensor $z$-score normalization of $\sqrt {\text {DN}}$. Location and scale are aligned, but real $\Phi $-sat-2 retains a wider spread than Sentinel-2 or the simulated domain in every band -- the residual gap normalization alone cannot close}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Per-band pixel agreement between co-registered real-$\Phi $-sat-2 and Sentinel-2B digital numbers (hexbin density, log scale; orange = ordinary least-squares fit; patches with $\leq $5\% cloud only). Point clouds are diffuse around the fitted line in every band, and several bands show a distinct vertical streak near zero $\Phi $-sat-2 DN spanning the full Sentinel-2 DN range, consistent with localized real-sensor dropout or saturation artifacts rather than measurement noise alone. }}{15}{figure.caption.12}\protected@file@percent }
\newlabel{fig:sensor-scatter}{{3.8}{15}{Per-band pixel agreement between co-registered real-$\Phi $-sat-2 and Sentinel-2B digital numbers (hexbin density, log scale; orange = ordinary least-squares fit; patches with $\leq $5\% cloud only). Point clouds are diffuse around the fitted line in every band, and several bands show a distinct vertical streak near zero $\Phi $-sat-2 DN spanning the full Sentinel-2 DN range, consistent with localized real-sensor dropout or saturation artifacts rather than measurement noise alone}{figure.caption.12}{}}
\citation{longepe2024orbitalai}
\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces Median per-band digital number, normalized by each sensor's own overall band mean (1.0 = that sensor's average). Sentinel-2B and simulated $\Phi $-sat-2 overlap almost exactly; real $\Phi $-sat-2 has a markedly different spectral shape, peaking at Red and dipping at RE1 and NIR. }}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:spectral-signature}{{3.9}{16}{Median per-band digital number, normalized by each sensor's own overall band mean (1.0 = that sensor's average). Sentinel-2B and simulated $\Phi $-sat-2 overlap almost exactly; real $\Phi $-sat-2 has a markedly different spectral shape, peaking at Red and dipping at RE1 and NIR}{figure.caption.13}{}}
