\@writefile{lof}{\contentsline {figure}{\numberline {3.10}{\ignorespaces Mean cross-sensor approximation error (Equation~\eqref  {eq:approx-error}) by dominant ESA WorldCover class, over 5,000 patches. Error bars are one standard deviation; the percentage above each bar is that class's share of labelled pixels in the sample. There are three classes at 0\% of presence in the samples (moss and lichen, snow and ice, mangroves) as they are rare in the dataset, but they are reported for completeness. }}{20}{figure.caption.15}\protected@file@percent }
\newlabel{fig:approx-error-class}{{3.10}{20}{Mean cross-sensor approximation error (Equation~\eqref {eq:approx-error}) by dominant ESA WorldCover class, over 5,000 patches. Error bars are one standard deviation; the percentage above each bar is that class's share of labelled pixels in the sample. There are three classes at 0\% of presence in the samples (moss and lichen, snow and ice, mangroves) as they are rare in the dataset, but they are reported for completeness}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.11}{\ignorespaces A coastal wetland patch (mean approximation error $1.24$, above the dataset-wide mean of $0.91$). Errors are located over the over open water, consistent with the class-level pattern of Figure~\ref {fig:approx-error-class}. }}{20}{figure.caption.17}\protected@file@percent }
\newlabel{fig:triplet-overlay-a}{{3.11}{20}{A coastal wetland patch (mean approximation error $1.24$, above the dataset-wide mean of $0.91$). Errors are located over the over open water, consistent with the class-level pattern of Figure~\ref {fig:approx-error-class}}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.12}{\ignorespaces A tree-cover/grassland boundary patch (mean approximation error $0.96$)}}{20}{figure.caption.18}\protected@file@percent }
\newlabel{fig:triplet-overlay-b}{{3.12}{20}{A tree-cover/grassland boundary patch (mean approximation error $0.96$)}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.13}{\ignorespaces A cropland patch in which the real $\Phi $-sat-2 view shows severe band-to-band misalignment, which is not present in the Sentinel-2 view. This real flight data shows the same phenomenon Equation~\eqref  {eq:misalign-l1a} models synthetically. This is a direct evidence that band misalignment can sometimes be a severe, real-sensor artifact. The scalar mean approximation error for this patch ($0.90$) is close to the dataset-wide mean despite the heavy artifact: Equation~\eqref  {eq:approx-error} averages absolute per-band intensity differences and is insensitive to spatial/geometric coherence, so it under-represents local misalignment, which shows the limitation of the metric. }}{21}{figure.caption.19}\protected@file@percent }
\newlabel{fig:triplet-overlay-c}{{3.13}{21}{A cropland patch in which the real $\Phi $-sat-2 view shows severe band-to-band misalignment, which is not present in the Sentinel-2 view. This real flight data shows the same phenomenon Equation~\eqref {eq:misalign-l1a} models synthetically. This is a direct evidence that band misalignment can sometimes be a severe, real-sensor artifact. The scalar mean approximation error for this patch ($0.90$) is close to the dataset-wide mean despite the heavy artifact: Equation~\eqref {eq:approx-error} averages absolute per-band intensity differences and is insensitive to spatial/geometric coherence, so it under-represents local misalignment, which shows the limitation of the metric}{figure.caption.19}{}}
