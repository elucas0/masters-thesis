\@writefile{toc}{\contentsline {section}{\numberline {3.5}Cross-Architecture Knowledge Distillation}{32}{section.3.5}\protected@file@percent }
\newlabel{sec:kd}{{3.5}{32}{Cross-Architecture Knowledge Distillation}{section.3.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.16}{\ignorespaces Cross-architecture distillation with domain-specific normalization. The frozen TerraMind teacher is evaluated only on the Sentinel-2 view, where it is trustworthy; its soft predictions supervise both student branches, which is possible because the two sensor views depict the same scene. The student is forwarded twice per patch, once per sensor, selecting its own batch-normalization statistics each time while sharing all convolutional weights. Both branches also receive the task loss against the single shared WorldCover label map. The contrastive terms were implemented and evaluated but carry zero weight in every result reported in Chapter~\ref {chap:results-discussion}. }}{33}{figure.caption.29}\protected@file@percent }
\newlabel{fig:kd-architecture}{{3.16}{33}{Cross-architecture distillation with domain-specific normalization. The frozen TerraMind teacher is evaluated only on the Sentinel-2 view, where it is trustworthy; its soft predictions supervise both student branches, which is possible because the two sensor views depict the same scene. The student is forwarded twice per patch, once per sensor, selecting its own batch-normalization statistics each time while sharing all convolutional weights. Both branches also receive the task loss against the single shared WorldCover label map. The contrastive terms were implemented and evaluated but carry zero weight in every result reported in Chapter~\ref {chap:results-discussion}}{figure.caption.29}{}}
