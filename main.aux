\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Top Workflow (Bent-Pipe Architecture): Data is acquired and minimally preprocessed on the satellite before being transmitted to the ground station, where in-depth analysis for anomalies is conducted. Bottom Workflow: The satellite extracts parameters and detects anomalies onboard, transmitting only the relevant anomaly data to the ground station, reducing data transmission and enabling faster detection. From Razzano et al.~\cite  {razzano2024ai}. }}{16}{figure.caption.7}\protected@file@percent }
\newlabel{fig:workflow}{{2.1}{16}{Top Workflow (Bent-Pipe Architecture): Data is acquired and minimally preprocessed on the satellite before being transmitted to the ground station, where in-depth analysis for anomalies is conducted. Bottom Workflow: The satellite extracts parameters and detects anomalies onboard, transmitting only the relevant anomaly data to the ground station, reducing data transmission and enabling faster detection. From Razzano et al.~\cite {razzano2024ai}}{figure.caption.7}{}}
