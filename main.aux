\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Per-band raw digital-number density by sensor (log-scaled $x$-axis; 400{,}000 sampled pixels). Sentinel-2B (blue) and simulated $\Phi $-sat-2 (orange) overlap so closely that blue is not visible beneath orange in any panel. Real $\Phi $-sat-2 (green) is concentrated roughly one order of magnitude lower, with a smaller secondary lobe extending into the Sentinel-2B/simulated value range in every band. }}{17}{figure.caption.12}\protected@file@percent }
\newlabel{fig:band-boxplots}{{3.7}{17}{Per-band raw digital-number density by sensor (log-scaled $x$-axis; 400{,}000 sampled pixels). Sentinel-2B (blue) and simulated $\Phi $-sat-2 (orange) overlap so closely that blue is not visible beneath orange in any panel. Real $\Phi $-sat-2 (green) is concentrated roughly one order of magnitude lower, with a smaller secondary lobe extending into the Sentinel-2B/simulated value range in every band}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces The same per-band densities after per-sensor $z$-score normalization of $\sqrt  {\text  {DN}}$. Sentinel-2B and simulated $\Phi $-sat-2 stay unimodal and closely overlapping; real $\Phi $-sat-2 is bimodal in every band, with a second mode near $z\approx +0.5$--$1.5$ that sharpens into a distinct spike near $z\approx 2.3$--$2.5$ in bands B04--B08, plausibly the smooth-clipped saturation population. Location and scale are aligned, but this shape difference is not something normalization alone can close. }}{18}{figure.caption.13}\protected@file@percent }
\newlabel{fig:band-boxplots-normalized}{{3.8}{18}{The same per-band densities after per-sensor $z$-score normalization of $\sqrt {\text {DN}}$. Sentinel-2B and simulated $\Phi $-sat-2 stay unimodal and closely overlapping; real $\Phi $-sat-2 is bimodal in every band, with a second mode near $z\approx +0.5$--$1.5$ that sharpens into a distinct spike near $z\approx 2.3$--$2.5$ in bands B04--B08, plausibly the smooth-clipped saturation population. Location and scale are aligned, but this shape difference is not something normalization alone can close}{figure.caption.13}{}}
\newlabel{eq:approx-error}{{3.1}{18}{Measured sensor discrepancy}{equation.3.1.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces Median per-band digital number, normalized by each sensor's own overall band mean (1.0 = that sensor's average). Sentinel-2B and simulated $\Phi $-sat-2 overlap almost exactly; real $\Phi $-sat-2 has a markedly different spectral shape, peaking at Red and dipping at RE1 and NIR. }}{19}{figure.caption.14}\protected@file@percent }
\newlabel{fig:spectral-signature}{{3.9}{19}{Median per-band digital number, normalized by each sensor's own overall band mean (1.0 = that sensor's average). Sentinel-2B and simulated $\Phi $-sat-2 overlap almost exactly; real $\Phi $-sat-2 has a markedly different spectral shape, peaking at Red and dipping at RE1 and NIR}{figure.caption.14}{}}
