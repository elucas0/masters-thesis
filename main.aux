\@writefile{toc}{\contentsline {section}{\numberline {3.2}Physics-Based Sensor Degradation Pipeline}{20}{section.3.2}\protected@file@percent }
\newlabel{sec:degradation-pipeline}{{3.2}{20}{Physics-Based Sensor Degradation Pipeline}{section.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.11}{\ignorespaces The updated degradation pipeline. A source Sentinel-2 L1 product passes through five physical stages in radiance space before conversion back to reflectance, each driven by its own auxiliary input: the centre-wavelength list and spectral response functions for the spectral adjustment, the 4.75\,m target ground sampling distance for the resampling, a misalignment standard deviation for the band-to-band shift, the per-band effective SNR for the noise term, and the Nyquist MTF for the optical blur. Solar zenith angle, Earth--Sun distance, and solar irradiance are retrieved per scene from the Copernicus Data Space OData API. Because every stage is parameterised separately, individual effects can be varied or switched off independently, and the segmentation mask is carried through the pipeline so that labels stay aligned with the degraded imagery. }}{21}{figure.caption.16}\protected@file@percent }
\newlabel{fig:simulator}{{3.11}{21}{The updated degradation pipeline. A source Sentinel-2 L1 product passes through five physical stages in radiance space before conversion back to reflectance, each driven by its own auxiliary input: the centre-wavelength list and spectral response functions for the spectral adjustment, the 4.75\,m target ground sampling distance for the resampling, a misalignment standard deviation for the band-to-band shift, the per-band effective SNR for the noise term, and the Nyquist MTF for the optical blur. Solar zenith angle, Earth--Sun distance, and solar irradiance are retrieved per scene from the Copernicus Data Space OData API. Because every stage is parameterised separately, individual effects can be varied or switched off independently, and the segmentation mask is carried through the pipeline so that labels stay aligned with the degraded imagery}{figure.caption.16}{}}
